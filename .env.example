# Copy this file to .env and fill in the blank values. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Laravel must send this value in the X-API-Key header (its AI_MARKING_KEY)
SERVICE_API_KEY=
# Marks under this confidence count as unreadable
UNREADABLE_BELOW=30
# Basic provisional marking when Gemini fails
FALLBACK_ENABLED=true
# The fallback refuses photos that OCR reads below this confidence
FALLBACK_MIN_OCR_CONFIDENCE=50
